{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "eko",
  "version": "0.1.0",
  "identifier": "com.codialo.eko",
  "build": {
    "beforeDevCommand": "npm run dev:web:desktop",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/desktop"
  },
  "app": {
    "windows": [
      {
        "title": "eko",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0Njg0OTc4MzhGQzE4QzUKUldURkdQdzRlRWxvZEt1dXpJZjN1TjZ1RkEySlZ1bVh4cnJPUFQzaWZjMVRFb1gvcks2bUUyaHAK",
      "endpoints": ["https://github.com/rider-vader/eko/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
