{
  "name": "eko",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev:web": "cross-env PLATFORM=desktop vite",
    "dev:web:desktop": "cross-env PLATFORM=desktop vite",
    "dev:web:mobile": "cross-env PLATFORM=mobile vite",
    "dev:web:mobile:tauri": "cross-env PLATFORM=mobile VITE_PORT=1422 vite",
    "dev:web:client": "cross-env PLATFORM=web/client VITE_PORT=5174 vite",
    "dev:desktop": "node scripts/start-desktop-dev.mjs",
    "dev:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-android-dev.ps1",
    "dev:android:studio": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-android-dev.ps1",
    "dev:android:direct": "tauri android dev",
    "open:android:studio": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/open-android-studio.ps1",
    "build:desktop": "tsc --noEmit && cross-env PLATFORM=desktop vite build",
    "build:mobile": "tsc --noEmit && cross-env PLATFORM=mobile vite build",
    "build:web:client": "tsc --noEmit && cross-env PLATFORM=web/client vite build",
    "build:production": "node scripts/build-production.mjs",
    "build:production:desktop": "tauri build",
    "build:production:android": "tauri android build --apk --target aarch64",
    "release:sync-version": "node scripts/sync-version.mjs",
    "release:merge-updater-json": "node scripts/merge-updater-json.mjs",
    "release:merge-public-updater-json": "node scripts/merge-public-updater-json.mjs",
    "build": "npm run build:desktop && npm run build:web:client",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "npm run test:types && npm run test:core",
    "test:types": "tsc --noEmit",
    "test:core": "tsx tests/core/session.test.ts",
    "test:desktop": "playwright test tests/desktop",
    "test:android:emulator": "tsx tests/android/emulator-smoke.ts",
    "test:latency": "tsx tests/latency/latency-regression.ts",
    "relay:dev": "wrangler dev --config relay/wrangler.jsonc",
    "relay:types": "wrangler types relay/env.d.ts --include-runtime false --config relay/wrangler.jsonc",
    "relay:test": "vitest run --config relay/vitest.config.ts",
    "relay:smoke:hosted": "node scripts/test-hosted-relay.mjs",
    "relay:test:media": "node scripts/test-hosted-media.mjs",
    "test:desktop:media": "node scripts/test-desktop-media.mjs",
    "relay:deploy:dry": "npm run build:web:client && wrangler deploy --dry-run --config relay/wrangler.jsonc",
    "relay:deploy": "npm run build:web:client && wrangler deploy --config relay/wrangler.jsonc",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/nunito": "5.2.7",
    "@hono/zod-validator": "0.8.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@zxing/browser": "^0.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "hono": "4.12.27",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.17.0",
    "next-themes": "^0.4.6",
    "qr-code-styling": "^1.9.2",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.11.2",
    "recharts": "3.8.0",
    "shadcn": "^4.10.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@cloudflare/vitest-pool-workers": "0.18.0",
    "@cloudflare/workers-types": "4.20260702.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "4.1.0",
    "wrangler": "4.107.0"
  }
}
