{
  "manifest_version": 3,
  "name": "eko",
  "version": "0.5.1",
  "minimum_chrome_version": "116",
  "description": "Share tab, window or system audio from Chrome with approved eko listeners.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "eko", "default_icon": { "32": "icons/32.png" } },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["tabCapture", "offscreen", "activeTab"],
  "host_permissions": ["https://eko.allpyq.in/*"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
