{
  "manifest_version": 3,
  "name": "Eko — Audio Share for Chrome",
  "version": "1.0.2",
  "description": "Echo your tab or computer audio to any phone nearby over Wi-Fi. Watch together while everyone listens on their own headphones.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Eko — Audio Share",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://*.allpyq.in/*",
    "https://eko.allpyq.in/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
